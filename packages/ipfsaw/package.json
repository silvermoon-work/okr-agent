{
  "name": "@silvermoon-work/ipfsaw",
  "version": "0.1.0-rc.0",
  "private": true,
  "description": "Bounded local YAML/JSON preview with explicitly bound immutable browser renderers.",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./cli": {
      "types": "./dist/cli.d.ts",
      "import": "./dist/cli.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "ipfsaw": "./dist/bin.js"
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.15.0"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/silvermoon-work/okr-agent.git",
    "directory": "packages/ipfsaw"
  },
  "homepage": "https://github.com/silvermoon-work/okr-agent/tree/main/packages/ipfsaw#readme",
  "bugs": {
    "url": "https://github.com/silvermoon-work/okr-agent/issues"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "clean": "node scripts/clean.mjs",
    "demo": "node scripts/demo.mjs",
    "lint": "node scripts/lint.mjs",
    "lint-package": "node scripts/lint-package.mjs",
    "test": "node scripts/test.mjs",
    "test-coverage": "node scripts/test-coverage.mjs",
    "typecheck": "node scripts/typecheck.mjs"
  },
  "dependencies": {
    "@ipld/car": "catalog:",
    "@silvermoon-work/ipfs-store": "catalog:",
    "commander": "catalog:",
    "ipfs-unixfs-importer": "catalog:",
    "multiformats": "catalog:",
    "yaml": "catalog:"
  },
  "devDependencies": {
    "@silvermoon-work/check-bundle-viewer": "workspace:*",
    "jsdom": "catalog:"
  }
}
