{
  "name": "@silvermoon-work/ipfsaw",
  "version": "0.1.0-rc.2",
  "description": "Bounded local YAML/JSON preview with explicitly bound immutable browser renderers.",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./cli": {
      "types": "./dist/cli.d.ts",
      "import": "./dist/cli.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "ipfsaw": "./dist/bin.js"
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.15.0"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/silvermoon-work/okr-agent.git",
    "directory": "packages/ipfsaw"
  },
  "homepage": "https://github.com/silvermoon-work/okr-agent/tree/main/packages/ipfsaw#readme",
  "bugs": {
    "url": "https://github.com/silvermoon-work/okr-agent/issues"
  },
  "scripts": {
    "build": "rimraf dist && tsc --project tsconfig.build.json && node scripts/build.mjs",
    "demo": "node scripts/demo.mjs",
    "lint": "eslint . --max-warnings=0",
    "lint-package": "publint",
    "prepublishOnly": "publish-gate check",
    "test": "vitest run --root . --config ../../vitest.config.ts",
    "test-coverage": "vitest run --root . --config ../../vitest.config.ts --coverage",
    "typecheck": "tsc --noEmit --project tsconfig.json"
  },
  "dependencies": {
    "@ipld/car": "catalog:",
    "@silvermoon-work/ipfs-store": "catalog:",
    "@silvermoon-work/task-protocol": "catalog:",
    "@silvermoon-work/ipfs-payload": "catalog:",
    "@silvermoon-work/task-builder": "catalog:",
    "commander": "catalog:",
    "ipfs-unixfs-importer": "catalog:",
    "multiformats": "catalog:",
    "yaml": "catalog:"
  },
  "devDependencies": {
    "@silvermoon-work/check-bundle-viewer": "workspace:*",
    "@silvermoon-work/task-sdk": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "vite": "catalog:",
    "jsdom": "catalog:"
  }
}
