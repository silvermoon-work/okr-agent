{
  "name": "@silvermoon-work/check.typescript-project",
  "version": "0.0.0",
  "private": true,
  "description": "Read-only TypeScript project convention Check with trusted release metadata.",
  "type": "module",
  "scripts": {
    "build": "node ../check-task-builder/dist/bin.js build",
    "lint": "eslint . --max-warnings=0",
    "smoke": "node scripts/smoke.mjs",
    "test": "vitest run --root . --config ../../vitest.config.ts",
    "test-coverage": "vitest run --root . --config ../../vitest.config.ts --coverage",
    "typecheck": "tsc --noEmit --project tsconfig.json"
  },
  "engines": {
    "node": "^22.15.0 || >=23.5.0"
  },
  "dependencies": {
    "@silvermoon-work/check-task-sdk": "workspace:*",
    "@sinclair/typebox": "catalog:",
    "acorn": "catalog:",
    "semver": "catalog:",
    "yaml": "catalog:"
  },
  "devDependencies": {
    "@types/semver": "catalog:",
    "@silvermoon-work/ipfs-store": "catalog:",
    "@silvermoon-work/check-task-builder": "workspace:*",
    "@silvermoon-work/task-builder": "catalog:",
    "@silvermoon-work/task-builder-cli": "catalog:",
    "@silvermoon-work/task-engine": "catalog:",
    "ipfs-unixfs-exporter": "catalog:"
  }
}
