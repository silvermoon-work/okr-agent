{
  "name": "@silvermoon-work/devtool.publish-gate",
  "version": "0.1.0-rc.0",
  "description": "Read-only npm prepublishOnly context checks for Silvermoon GitHub Actions releases.",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./cli": {
      "types": "./dist/cli.d.ts",
      "import": "./dist/cli.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "publish-gate": "./dist/bin.js"
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.15.0"
  },
  "scripts": {
    "build": "tsc --project tsconfig.build.json",
    "lint": "eslint . --max-warnings=0",
    "lint-package": "publint",
    "test": "vitest run --root . --config ../../vitest.config.ts",
    "test-coverage": "vitest run --root . --config ../../vitest.config.ts --coverage",
    "typecheck": "tsc --noEmit --project tsconfig.json"
  },
  "dependencies": {
    "commander": "catalog:",
    "semver": "catalog:",
    "yaml": "catalog:"
  },
  "devDependencies": {
    "@types/semver": "catalog:"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/silvermoon-work/okr-agent.git",
    "directory": "packages/devtool.publish-gate"
  },
  "homepage": "https://github.com/silvermoon-work/okr-agent/tree/main/packages/devtool.publish-gate#readme",
  "bugs": {
    "url": "https://github.com/silvermoon-work/okr-agent/issues"
  }
}
