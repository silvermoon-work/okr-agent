{
  "name": "@silvermoon-work/check-bundle-viewer",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^22.15.0 || >=23.5.0"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./style.css": "./src/style.css"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "lint": "eslint . --max-warnings=0",
    "test": "vitest run --root . --config ../../vitest.config.ts",
    "test-coverage": "vitest run --root . --config ../../vitest.config.ts --coverage",
    "typecheck": "tsc --noEmit --project tsconfig.json"
  },
  "dependencies": {
    "ajv": "catalog:",
    "react": "catalog:",
    "react-markdown": "catalog:",
    "remark-gfm": "catalog:"
  },
  "devDependencies": {
    "vite": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "react-dom": "catalog:",
    "jsdom": "catalog:"
  }
}
