{
  "name": "@silvermoon-work/check-task-sdk",
  "version": "0.1.0-rc.1",
  "description": "Typed Check Task contracts and restricted callbacks composed with the Task SDK.",
  "keywords": [
    "check",
    "task",
    "sdk",
    "typescript"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./contracts": {
      "types": "./dist/contracts.d.ts",
      "import": "./dist/contracts.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "clean": "node scripts/clean.mjs",
    "lint": "node scripts/lint.mjs",
    "lint-package": "node scripts/lint-package.mjs",
    "test": "node scripts/test.mjs",
    "test-coverage": "node scripts/test-coverage.mjs",
    "typecheck": "node scripts/typecheck.mjs"
  },
  "engines": {
    "node": ">=22.15.0"
  },
  "dependencies": {
    "@silvermoon-work/task-sdk": "catalog:",
    "@sinclair/typebox": "catalog:"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/silvermoon-work/okr-agent.git",
    "directory": "packages/check-task-sdk"
  },
  "homepage": "https://github.com/silvermoon-work/okr-agent/tree/main/packages/check-task-sdk#readme",
  "bugs": {
    "url": "https://github.com/silvermoon-work/okr-agent/issues"
  }
}
