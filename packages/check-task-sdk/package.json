{
  "name": "@silvermoon-work/check-task-sdk",
  "version": "0.1.0-rc.1",
  "description": "Typed Check Task contracts and restricted callbacks composed with the Task SDK.",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./contracts": {
      "types": "./dist/contracts.d.ts",
      "import": "./dist/contracts.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "lint": "eslint . --max-warnings=0",
    "test": "vitest run --root . --config ../../vitest.config.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "engines": {
    "node": ">=22.13"
  },
  "dependencies": {
    "@silvermoon-work/task-sdk": "catalog:",
    "@sinclair/typebox": "catalog:"
  },
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/silvermoon-work/okr-agent.git",
    "directory": "packages/check-task-sdk"
  },
  "homepage": "https://github.com/silvermoon-work/okr-agent/tree/main/packages/check-task-sdk#readme",
  "bugs": {
    "url": "https://github.com/silvermoon-work/okr-agent/issues"
  }
}
