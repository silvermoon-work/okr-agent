{
  "name": "@silvermoon-work/check.nodejs-toolchain",
  "version": "0.0.0",
  "private": true,
  "description": "Node.js Toolchain Check — private CAR author project.",
  "type": "module",
  "scripts": {
    "build": "check-task-builder build",
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "lint": "eslint . --max-warnings=0",
    "test": "vitest run --root . --config ../../vitest.config.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "engines": {
    "node": "^22.15.0 || >=23.5.0"
  },
  "dependencies": {
    "@silvermoon-work/check-task-sdk": "workspace:*",
    "@sinclair/typebox": "catalog:",
    "yaml": "catalog:"
  },
  "devDependencies": {
    "@silvermoon-work/ipfs-store": "catalog:",
    "@silvermoon-work/check-task-builder": "workspace:*",
    "@silvermoon-work/task-builder": "catalog:",
    "@silvermoon-work/task-builder-cli": "catalog:",
    "@silvermoon-work/task-engine": "catalog:",
    "ipfs-unixfs-exporter": "catalog:",
    "nrm": "catalog:"
  }
}
