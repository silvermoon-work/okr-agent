{
  "name": "@silvermoon-work/content-bundle",
  "version": "0.1.0-rc.0",
  "description": "Validated immutable UnixFS content bundles with CID-addressed JSON Schemas.",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "engines": {
    "node": ">=22.15.0"
  },
  "license": "MIT",
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/silvermoon-work/okr-agent.git",
    "directory": "packages/content-bundle"
  },
  "homepage": "https://github.com/silvermoon-work/okr-agent/tree/main/packages/content-bundle#readme",
  "bugs": {
    "url": "https://github.com/silvermoon-work/okr-agent/issues"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "rimraf dist && tsc --project tsconfig.build.json",
    "lint": "eslint . --max-warnings=0",
    "lint-package": "publint --strict",
    "prepublishOnly": "publish-gate check",
    "test": "vitest run --root . --config ../../vitest.config.ts",
    "test-coverage": "vitest run --root . --config ../../vitest.config.ts --coverage",
    "typecheck": "tsc --noEmit --project tsconfig.json"
  },
  "dependencies": {
    "@ipld/dag-cbor": "catalog:",
    "@silvermoon-work/ipfs-store": "catalog:",
    "ajv": "catalog:",
    "multiformats": "catalog:",
    "yaml": "catalog:"
  },
  "devDependencies": {
    "ipfs-unixfs-importer": "catalog:"
  }
}
