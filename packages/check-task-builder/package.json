{
  "name": "@silvermoon-work/check-task-builder",
  "version": "0.1.0-rc.1",
  "description": "Build Check projects into standard Task Bundles and CARs.",
  "keywords": [
    "check",
    "task",
    "builder",
    "typescript"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./cli": {
      "types": "./dist/cli.d.ts",
      "import": "./dist/cli.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "check-task-builder": "./dist/bin.js"
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "clean": "node scripts/clean.mjs",
    "lint": "node scripts/lint.mjs",
    "lint-package": "node scripts/lint-package.mjs",
    "smoke": "node scripts/smoke.mjs",
    "test": "node scripts/test.mjs",
    "test-coverage": "node scripts/test-coverage.mjs",
    "typecheck": "node scripts/typecheck.mjs"
  },
  "engines": {
    "node": ">=22.15.0"
  },
  "dependencies": {
    "@silvermoon-work/ipfs-store": "catalog:",
    "@silvermoon-work/check-task-sdk": "workspace:*",
    "@silvermoon-work/task-builder": "catalog:",
    "@silvermoon-work/task-builder-cli": "catalog:",
    "commander": "catalog:",
    "yaml": "catalog:"
  },
  "devDependencies": {
    "@silvermoon-work/task-engine": "catalog:",
    "@silvermoon-work/task-sdk": "catalog:",
    "@sinclair/typebox": "catalog:",
    "ipfs-unixfs-exporter": "catalog:"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/silvermoon-work/okr-agent.git",
    "directory": "packages/check-task-builder"
  },
  "homepage": "https://github.com/silvermoon-work/okr-agent/tree/main/packages/check-task-builder#readme",
  "bugs": {
    "url": "https://github.com/silvermoon-work/okr-agent/issues"
  }
}
