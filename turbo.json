{
  "$schema": "https://turborepo.com/schema.json",
  "globalDependencies": [
    ".node-version",
    "tsconfig.json",
    "vitest.config.ts",
    "scripts/lib/tools.mjs",
    "docs/silvermoon-single-checker.yaml",
    "docs/silvermoon-commit-check.yaml",
    "docs/silvermoon-create-idea-check.yaml"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "test-coverage": {
      "dependsOn": ["^build"],
      "outputs": ["coverage/**"]
    },
    "lint-package": {
      "dependsOn": ["build"],
      "outputs": []
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "smoke": {
      "dependsOn": ["build"],
      "cache": false
    },
    "native-test": {
      "dependsOn": ["build"],
      "cache": false
    },
    "nvm-smoke": {
      "dependsOn": ["build"],
      "cache": false
    },
    "demo": {
      "dependsOn": ["build"],
      "cache": false,
      "persistent": true
    },
    "typecheck": {
      "dependsOn": ["^build"],
      "outputs": []
    }
  }
}
