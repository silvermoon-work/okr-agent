{
  "name": "@silvermoon-work/example-app",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^22.15.0 || >=23.5.0"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc --project tsconfig.build.json",
