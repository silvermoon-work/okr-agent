{
  "name": "@silvermoon-work/okr-agent",
  "version": "0.0.0",
  "description": "OKR agent monorepo built with pnpm workspaces and Turborepo.",
  "keywords": [
    "typescript",
    "pnpm",
    "monorepo",
    "turborepo"
  ],
  "homepage": "https://github.com/silvermoon-work/okr-agent#readme",
  "bugs": {
    "url": "https://github.com/silvermoon-work/okr-agent/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/silvermoon-work/okr-agent.git"
  },
  "license": "MIT",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^22.15.0 || >=23.5.0"
  },
  "packageManager": "pnpm@11.28.12",
  "scripts": {
    "build": "turbo run build",
    "check": "node scripts/check.mjs",
    "clean": "node scripts/clean.mjs",
    "format": "prettier --write .",
    "format-check": "prettier --check .",
    "lint": "eslint . --max-warnings=0",
    "lint-package": "node scripts/lint-package.mjs",
    "release": "node scripts/release.mjs",
    "release-dry-run": "node scripts/release-dry-run.mjs",
    "test": "turbo run test --concurrency=1 && pnpm test-release",
    "test-coverage": "turbo run test-coverage --concurrency=1 && pnpm test-release",
    "test-release": "node scripts/test-release.mjs",
    "typecheck": "tsc --noEmit --project tsconfig.json && turbo run typecheck"
  },
  "devDependencies": {
    "@eslint/js": "catalog:",
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "eslint": "catalog:",
    "globals": "catalog:",
    "acorn": "catalog:",
    "prettier": "catalog:",
    "publint": "catalog:",
    "semver": "catalog:",
    "turbo": "catalog:",
    "typescript": "catalog:",
    "typescript-eslint": "catalog:",
    "vitest": "catalog:",
    "yaml": "catalog:"
  }
}
